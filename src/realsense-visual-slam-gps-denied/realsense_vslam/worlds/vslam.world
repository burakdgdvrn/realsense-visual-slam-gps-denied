<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">

    <!-- ============ IŞIK & ZEMIN ============ -->
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- ============ ROS PLUGIN'LERİ ============ -->
    <plugin name="gazebo_ros_factory" filename="libgazebo_ros_factory.so"/>
    <plugin name="gazebo_ros_init" filename="libgazebo_ros_init.so"/>
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
    </plugin>

    <!-- ============================================================
         GPS-DENIED TEST ORTAMI — DEPO / İÇ MEKAN
         
         Boyut: 16m x 12m kapalı alan
         Drone kalkış: (0, 0, 1.0)
         Duvar yüksekliği: 3m
         TEXTURE'LI materyaller — VO için feature zenginliği
         ============================================================ -->

    <!-- ====== DIŞ DUVARLAR (16m x 12m) — TUĞLA DOKU ====== -->
    <!-- Kuzey Duvarı -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 6 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>16 0.15 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>16 0.15 3</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Bricks</name></script></material>
        </visual>
      </link>
    </model>

    <!-- Güney Duvarı -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -6 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>16 0.15 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>16 0.15 3</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Bricks</name></script></material>
        </visual>
      </link>
    </model>

    <!-- Doğu Duvarı -->
    <model name="wall_east">
      <static>true</static>
      <pose>8 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 12 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 12 3</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/CeilingTiled</name></script></material>
        </visual>
      </link>
    </model>

    <!-- Batı Duvarı -->
    <model name="wall_west">
      <static>true</static>
      <pose>-8 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 12 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 12 3</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/CeilingTiled</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ====== İÇ BÖLME DUVARLARI — AHŞAP DOKU ====== -->
    <!-- Orta bölme duvarı (yatay) -->
    <model name="partition_h1">
      <static>true</static>
      <pose>-3 1.5 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>6 0.12 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6 0.12 3</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
      </link>
    </model>

    <!-- Dikey bölme duvarı -->
    <model name="partition_v1">
      <static>true</static>
      <pose>4 -1.5 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.12 5 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.12 5 3</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/WoodFloor</name></script></material>
        </visual>
      </link>
    </model>

    <!-- L-şekli koridor duvarı -->
    <model name="partition_h2">
      <static>true</static>
      <pose>2 -3 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>4 0.12 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4 0.12 3</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Residential</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ====== SÜTUNLAR — BETON DOKU ====== -->
    <model name="pillar_1">
      <static>true</static>
      <pose>-4 -3 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.4 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.4 2.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Rocky</name></script></material>
        </visual>
      </link>
    </model>

    <model name="pillar_2">
      <static>true</static>
      <pose>-4 3 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.4 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.4 2.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Rocky</name></script></material>
        </visual>
      </link>
    </model>

    <model name="pillar_3">
      <static>true</static>
      <pose>2 4 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.4 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.4 2.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <model name="pillar_4">
      <static>true</static>
      <pose>6 2 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.4 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.4 2.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Rocky</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ====== RAFLAR — AHŞAP DOKU ====== -->
    <model name="shelf_large_1">
      <static>true</static>
      <pose>-6.5 -2 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.8 0.6 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.8 0.6 1.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
      </link>
    </model>

    <model name="shelf_long_1">
      <static>true</static>
      <pose>-2 5.3 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3.5 0.5 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.5 0.5 1.2</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/WoodPallet</name></script></material>
        </visual>
      </link>
    </model>

    <model name="shelf_right">
      <static>true</static>
      <pose>6 -4 0.9 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2 0.5 1.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 0.5 1.8</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/WoodFloor</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ====== KUTULAR — AHŞAP PALET DOKU ====== -->
    <model name="crate_1">
      <static>true</static>
      <pose>-2 -4.5 0.3 0 0 0.3</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 0.6 0.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.6 0.6</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/WoodPallet</name></script></material>
        </visual>
      </link>
    </model>

    <model name="crate_2">
      <static>true</static>
      <pose>-1.5 -4.8 0.3 0 0 -0.2</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.5 0.5 0.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 0.6</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
      </link>
    </model>

    <model name="crate_3">
      <static>true</static>
      <pose>-1.8 -4.6 0.9 0 0 0.1</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.45 0.45 0.45</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.45 0.45 0.45</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Residential</name></script></material>
        </visual>
      </link>
    </model>

    <model name="crate_4">
      <static>true</static>
      <pose>5.5 0 0.35 0 0 0.5</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.7 0.7 0.7</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.7 0.7 0.7</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/WoodPallet</name></script></material>
        </visual>
      </link>
    </model>

    <model name="crate_5">
      <static>true</static>
      <pose>6.5 0.8 0.25 0 0 -0.4</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Bricks</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ====== VARİLLER ====== -->
    <model name="barrel_1">
      <static>true</static>
      <pose>-6 4 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.25</radius><length>0.9</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>0.9</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Blue</name></script></material>
        </visual>
      </link>
    </model>

    <model name="barrel_2">
      <static>true</static>
      <pose>-5.5 4.3 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.25</radius><length>0.9</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>0.9</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Red</name></script></material>
        </visual>
      </link>
    </model>

    <model name="barrel_3">
      <static>true</static>
      <pose>3 -5 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.25</radius><length>0.9</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>0.9</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Yellow</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ====== MASA / TEZGAH ====== -->
    <model name="table_1">
      <static>true</static>
      <pose>1 3.5 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.5 0.8 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.5 0.8 0.8</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
      </link>
    </model>

    <model name="workbench">
      <static>true</static>
      <pose>6.5 4.5 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.5 0.7 0.9</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.5 0.7 0.9</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/WoodFloor</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ====== DUVAR PANOLARI (Drone yüksekliğinde feature) ====== -->
    <model name="wall_panel_1">
      <static>true</static>
      <pose>-3 -5.85 1.3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.5 0.05 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.5 0.05 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>
      </link>
    </model>

    <model name="wall_panel_2">
      <static>true</static>
      <pose>-7.85 0 1.3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.05 2.0 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 2.0 1.2</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Residential</name></script></material>
        </visual>
      </link>
    </model>

    <model name="wall_panel_3">
      <static>true</static>
      <pose>7.85 -2 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.05 1.8 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 1.8 0.8</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/CeilingTiled</name></script></material>
        </visual>

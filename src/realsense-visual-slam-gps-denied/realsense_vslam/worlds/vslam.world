<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">

    <!-- ============ IŞIK & ZEMIN ============ -->
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- ============ ROS PLUGIN'LERİ ============ -->
    <plugin name="gazebo_ros_factory" filename="libgazebo_ros_factory.so"/>
    <plugin name="gazebo_ros_init" filename="libgazebo_ros_init.so"/>
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
    </plugin>

    <!-- ============================================================
         GPS-DENIED TEST ORTAMI — BÜYÜK DEPO (SÜRÜ İÇİN GENİŞLETİLDİ)
         
         Boyut: 30m x 20m kapalı alan
         Drone kalkış: (0, 0, 1.0)
         Özellikler: Sürü uçuşuna (V-formasyonu) uygun geniş orta alan,
                     duvar kenarlarında görsel zenginlik için dokulu objeler.
         ============================================================ -->

    <!-- ====== DIŞ DUVARLAR (30m x 20m) — TUĞLA DOKU ====== -->
    <!-- Kuzey Duvarı -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 10 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>30 0.2 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>30 0.2 3</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Bricks</name></script></material>
        </visual>
      </link>
    </model>

    <!-- Güney Duvarı -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -10 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>30 0.2 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>30 0.2 3</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Bricks</name></script></material>
        </visual>
      </link>
    </model>

    <!-- Doğu Duvarı -->
    <model name="wall_east">
      <static>true</static>
      <pose>15 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 20 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 20 3</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/CeilingTiled</name></script></material>
        </visual>
      </link>
    </model>

    <!-- Batı Duvarı -->
    <model name="wall_west">
      <static>true</static>
      <pose>-15 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 20 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 20 3</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/CeilingTiled</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ====== İÇ BÖLME DUVARLARI (Orta alanı daraltmamak için kenarlara çekildi) ====== -->
    <model name="partition_nw">
      <static>true</static>
      <pose>-10 6 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8 0.15 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8 0.15 3</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
      </link>
    </model>

    <model name="partition_se">
      <static>true</static>
      <pose>10 -6 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8 0.15 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8 0.15 3</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/WoodFloor</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ====== SÜTUNLAR (Görsel referans noktaları, güvenli mesafede) ====== -->
    <model name="pillar_1">
      <static>true</static>
      <pose>-8 -5 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 0.6 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.6 3</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Rocky</name></script></material>
        </visual>
      </link>
    </model>

    <model name="pillar_2">
      <static>true</static>
      <pose>-8 5 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 0.6 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.6 3</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Rocky</name></script></material>
        </visual>
      </link>
    </model>

    <model name="pillar_3">
      <static>true</static>
      <pose>8 5 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 0.6 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.6 3</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <model name="pillar_4">
      <static>true</static>
      <pose>8 -5 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 0.6 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.6 3</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Rocky</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ====== RAFLAR ====== -->
    <model name="shelf_long_north">
      <static>true</static>
      <pose>0 9.5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8 0.8 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8 0.8 2</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/WoodPallet</name></script></material>
        </visual>
      </link>
    </model>

    <model name="shelf_west">
      <static>true</static>
      <pose>-14.5 0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.8 6 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.8 6 2</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
      </link>
    </model>

    <model name="shelf_east">
      <static>true</static>
      <pose>14.5 0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.8 6 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.8 6 2</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/WoodFloor</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ====== KUTULAR & VARİLLER (Daha büyük alan için dağıtıldı) ====== -->
    <model name="crate_stack_1">
      <static>true</static>
      <pose>-12 -8 0.5 0 0 0.3</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2 1.2 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 1.2 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/WoodPallet</name></script></material>
        </visual>
      </link>
    </model>

    <model name="crate_stack_2">
      <static>true</static>
      <pose>12 8 0.5 0 0 -0.2</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.0 1.0 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 1.0 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Bricks</name></script></material>
        </visual>
      </link>
    </model>

    <model name="barrels_sw">
      <static>true</static>
      <pose>-10 -9 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.4</radius><length>1.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.4</radius><length>1.0</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Blue</name></script></material>
        </visual>
      </link>
    </model>

    <model name="barrels_ne">
      <static>true</static>
      <pose>12 6 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.4</radius><length>1.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.4</radius><length>1.0</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Red</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ====== DUVAR PANOLARI (Görsel Zenginlik) ====== -->
    <model name="wall_panel_1">
      <static>true</static>
      <pose>-5 -9.85 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3 0.1 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3 0.1 1.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>
      </link>
    </model>

    <model name="wall_panel_2">
      <static>true</static>
      <pose>5 9.85 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3 0.1 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3 0.1 1.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Yellow</name></script></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>